<Window x:Class="MxLintManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MxLintManager"
        Title="MxLint Manager" Height="720" Width="1202"
        MinWidth="900" MinHeight="400"
        FontFamily="Segoe UI" Background="#F3F3F3">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Header: docked top, fixed height, stretches horizontally -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Border Width="38" Height="38" Background="{StaticResource TextBrush}" CornerRadius="4" Margin="0,0,14,0">
                        <TextBlock Text="M" Foreground="White" FontFamily="Consolas" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Studio Pro Extension Manager" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Scans local installations &amp; manages the companion extension" FontSize="12.5" Foreground="#6B7280" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastScannedLabel}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="{Binding ScanButtonLabel}" Command="{Binding ScanCommand}" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: fills everything below the header -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Section title -->
                <RowDefinition Height="Auto"/>
                <!-- Toolbar -->
                <RowDefinition Height="*"/>
                <!-- Table takes the rest -->
            </Grid.RowDefinitions>

            <!-- Section: Detected installations -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Detected installations" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{Binding SummaryLabel}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
            </StackPanel>

            <!-- Toolbar: search + filter -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,10,0"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Filter by version or path…"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedFilter}" SelectedValuePath="Tag">
                    <ComboBoxItem Content="All installations" Tag="all"/>
                    <ComboBoxItem Content="Extension installed" Tag="installed"/>
                    <ComboBoxItem Content="No extension" Tag="none"/>
                    <ComboBoxItem Content="Running now" Tag="running"/>
                </ComboBox>
            </Grid>

            <!-- Installations table -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" CornerRadius="4" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Column header (stays put) -->
                        <RowDefinition Height="*"/>
                        <!-- Scrolling rows -->
                    </Grid.RowDefinitions>

                    <!-- Column header: same column widths and horizontal margin as the rows -->
                    <Border Grid.Row="0" Background="#F7F7F7" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="326"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VERSION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,9"/>
                            <TextBlock Grid.Column="1" Text="PATH" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,9"/>
                            <TextBlock Grid.Column="2" Text="EXTENSION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,9"/>
                            <TextBlock Grid.Column="3" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,9"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding StudioProVersionsView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource RowBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid Margin="14,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="326"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Version + running state -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding StudioProVersion}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                    <Ellipse Width="6" Height="6" Fill="#D97706" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Running" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RunningBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Path (shrinks with the window, trims with ellipsis) -->
                                            <TextBlock Grid.Column="1" Text="{Binding InstallationPath}" FontFamily="Consolas" FontSize="11.5"
                                                       Foreground="{StaticResource MonoMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Margin="0,0,10,0" ToolTip="{Binding InstallationPath}"/>

                                            <!-- Extension status -->
                                            <TextBlock Grid.Column="2" Text="{Binding InstalledVersion}" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ExtOkBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <ComboBox Margin="0,0,8,0" FontFamily="Consolas"
                                                          ItemsSource="{Binding DataContext.AvailableReleases, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding SelectedRelease}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                                                          DisplayMemberPath="TagName" MinWidth="80"/>
                                                <Button Content="Remove" Margin="0,0,8,0" Style="{StaticResource RemoveButton}"
                                                        Command="{Binding RemoveCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"/>
                                                <Button Content="{Binding ActionText}" Style="{StaticResource PrimaryButton}" Width="100"
                                                        Command="{Binding InstallCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
